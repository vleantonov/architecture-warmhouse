@startuml Warmhouse_Monitoring_ToBe
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam nodesep 35
skinparam ranksep 45
title Тёплый дом — компоненты сервиса мониторинга
Person(user, "Пользователь")
Container(web, "Личный кабинет", "Веб-приложение")
Container(devices, "Сервис устройств", "Go")
Container_Boundary(service, "Сервис мониторинга") {
    Component(api, "HTTP-контроллер мониторинга", "Компонент")
    Component(reader, "Получение последних показаний", "Контекст стратегии")
    Component(writer, "Явная запись показания", "Компонент")
    Component(viewer, "Просмотр камеры", "Компонент")
    Component(model, "Модель показаний", "Reading")
    Component(converter, "Преобразование единицы температуры", "UnitConverter")
    Component(client, "Клиент сервиса устройств", "Компонент")
    Component(repository, "Репозиторий последних показаний", "ReadingRepository")
    Component(temperature, "Адаптер датчика температуры", "Стратегия ReadingAdapter")
    Component(thermostat, "Адаптер термостата", "Стратегия ReadingAdapter")
    Component(light, "Адаптер реле света", "Стратегия ReadingAdapter")
    Component(gate, "Адаптер контроллера ворот", "Стратегия ReadingAdapter")
    Component(camera, "Адаптер камеры", "Стратегия ReadingAdapter")
    Component(video, "Адаптер видеопотока", "Компонент")
}
ContainerDb(db, "БД последних показаний", "PostgreSQL")
System_Ext(heat, "Датчики и термостаты")
System_Ext(actuators, "Реле и контроллеры ворот")
System_Ext(cameras, "Камеры партнёров")
Rel(user, web, "Управляет домом", "HTTPS")
Rel(web, api, "Показания и видео", "HTTPS / JSON; видеопоток")
Rel(api, reader, "Вызывает")
Rel(api, writer, "Записывает показание")
Rel(api, viewer, "Вызывает")
Rel_L(reader, client, "Получает устройства")
Rel_L(writer, client, "Получает Device")
Rel_L(viewer, client, "Получает Device")
Rel(reader, temperature, "Выбирает для TEMPERATURE_SENSOR")
Rel(reader, thermostat, "Выбирает для THERMOSTAT")
Rel(reader, light, "Выбирает для LIGHT_RELAY")
Rel(reader, gate, "Выбирает для GATE_CONTROLLER")
Rel(reader, camera, "Выбирает для CAMERA")
Rel(reader, model, "Использует")
Rel(writer, model, "Проверяет")
Rel(reader, converter, "Преобразует единицы")
Rel(writer, converter, "Преобразует единицы")
Rel(reader, repository, "Читает и пишет")
Rel(writer, repository, "Записывает")
Rel(repository, db, "Читает и пишет", "SQL")
Rel(viewer, video, "Открывает поток")
Rel_L(client, devices, "Получает устройства", "HTTPS / JSON")
Rel(temperature, heat, "Опрашивает", "HTTPS / JSON")
Rel(thermostat, heat, "Опрашивает", "HTTPS / JSON")
Rel(light, actuators, "Читает состояние света", "HTTPS / JSON")
Rel(gate, actuators, "Читает состояние замка", "HTTPS / JSON")
Rel(camera, cameras, "Проверяет доступность", "HTTPS / JSON")
Rel(video, cameras, "Запрашивает поток", "Видеопоток")
@enduml
